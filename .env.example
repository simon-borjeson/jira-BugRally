# Optional. The easiest way to connect is the Settings page in the app.
# If you prefer a file: copy this to .env and fill in your Jira Cloud details.
# Values saved on the Settings page take priority over this file.

# Your site, e.g. https://your-company.atlassian.net
JIRA_BASE_URL=
# The email you log in to Jira with
JIRA_EMAIL=
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Optional: template used when you create a new project from the app.
# Default is a company-managed Kanban project.
# JIRA_PROJECT_TEMPLATE=com.pyxis.greenhopper.jira:gh-simplified-kanban-classic

# Optional: port for the local server
# PORT=3000

# Optional: which network address to listen on. Default 127.0.0.1 (this computer only).
# Set 0.0.0.0 to share on your network (then also set PUBLIC_URL).
# HOST=127.0.0.1

# Optional: the address people open in the browser. Used for the "Sign in with Atlassian"
# callback URL (<PUBLIC_URL>/auth/callback). Default http://localhost:<PORT>
# PUBLIC_URL=http://localhost:3000

# Optional: max upload size per file, in MB (default 50)
# MAX_UPLOAD_MB=50
